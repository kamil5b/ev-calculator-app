---
import '../styles/globals.css';
import {
  APPLE_TOUCH_ICON,
  BASE_PATH,
  FAVICON,
  OG_IMAGE,
  PWA_MANIFEST,
  SITE_CANONICAL,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_NAME,
  SITE_TITLE,
  SEO_JSON_LD,
  THEME_COLOR,
  SITE_URL,
} from '../infrastructure/config/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const ogImage = new URL(OG_IMAGE, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE_KEYWORDS} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={SITE_CANONICAL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_CANONICAL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="EV Calculator app icon" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="EV Calculator app icon" />

    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="light" />
    <link rel="manifest" href={`${BASE_PATH}/manifest.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={FAVICON} />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={PWA_MANIFEST.short_name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="referrer" content="no-referrer" />

    {/* Structured data; `is:inline` keeps Astro from bundling it, and the CSP
        hash for these exact bytes is added in `astro.config.mjs`. */}
    <script type="application/ld+json" is:inline set:html={SEO_JSON_LD} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to calculator
    </a>

    <slot />

    <script>
      /**
       * Registers the service worker that powers offline use (PRD 4.1, 4.3).
       *
       * Production only: the dev server serves unbundled modules, so precaching
       * them would hand the developer a stale app. Offline behaviour is verified
       * with `npm run build && npm run preview`, which runs the real bundle.
       */
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        // `BASE_URL` is configured without a trailing slash, so normalise it
        // before appending the script name.
        const base = import.meta.env.BASE_URL.endsWith('/')
          ? import.meta.env.BASE_URL
          : `${import.meta.env.BASE_URL}/`;

        const register = () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            // Offline support is an enhancement; never surface it as an error.
          });
        };

        // Defer to idle time so registration never competes with the island
        // bundle for bandwidth on a slow connection.
        const start = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(register, { timeout: 2000 });
          } else {
            register();
          }
        };

        /*
         * The `load` gate has to be attached while the document is still
         * loading. `requestIdleCallback` normally fires *after* `load`, so
         * adding the listener from inside it would attach a handler for an
         * event that has already happened — registration would silently never
         * run, leaving the app with no offline support and no install prompt.
         */
        if (document.readyState === 'complete') {
          start();
        } else {
          window.addEventListener('load', start, { once: true });
        }
      }
    </script>
  </body>
</html>
